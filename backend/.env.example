PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173
TRUST_PROXY=0

# Configure this URL for your local PostgreSQL database before starting the API.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/valesense?schema=public
JWT_SECRET=
JWT_EXPIRES_IN=8h
PASSWORD_RESET_EXPIRES_MINUTES=15

OTP_STORE=prisma
OTP_ISSUER=ValeSense
OTP_WINDOW=1
OTP_ENCRYPTION_KEY=
OTP_CHALLENGE_EXPIRES_SECONDS=300
OTP_RECOVERY_CODES_COUNT=10
# DEV_LOG_RESET_LINK=false

# Optional bootstrap administrator; provide all three values to enable it.
# ADMIN_NAME=Administrador ValeSense
# ADMIN_EMAIL=admin@example.invalid
# ADMIN_PASSWORD=

# Optional public ThingSpeak channel identifier and polling interval.
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_POLL_SECONDS=60
